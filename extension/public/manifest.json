{
  "manifest_version": 3,
  "name": "JobRecall — Application Memory & Eligibility Triage",
  "version": "0.1.0",
  "description": "Remember where you applied and surface stated job restrictions before applying again. 100% local-first.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open JobRecall Side Panel"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.indeed.com/*",
        "https://*.dice.com/*",
        "https://*.greenhouse.io/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.lever.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.icims.com/*",
        "https://*.eightfold.ai/*",
        "https://*.workable.com/*",
        "https://*.bamboohr.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
