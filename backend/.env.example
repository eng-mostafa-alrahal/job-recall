# Server binding (use 0.0.0.0 inside Docker; docker-compose binds 127.0.0.1:8765 on host)
JOBRECALL_HOST=127.0.0.1
JOBRECALL_PORT=8765

# Local API Authentication Token (shared between backend and browser extension Side Panel)
# Leave as "dev-local-token-change-me" or set your own random hex token
JOBRECALL_API_TOKEN=jobrecall-local-dev-token-2026

# SQLite Database URL
JOBRECALL_DB_URL=sqlite:///./data/jobrecall.db

# Optional External LLM Configuration (only used when clicking "Analyze Requirements")
# Supported providers: openai | anthropic | google | ollama | mock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15.0

# Provider API Keys (never exposed to browser extension)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
